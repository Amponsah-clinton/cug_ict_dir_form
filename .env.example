# Required in production
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=cugregistration.academicdigital.space,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://cugregistration.academicdigital.space

# Optional — only needed if using a separate Postgres DB for Django sessions
# Leave blank to use SQLite (fine for single-instance deploys)
DATABASE_URL=

# Required — Supabase (corrections state + director confirmation)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Required — Resend SMTP (outgoing email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@academicdigital.space
